{
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "window_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "window_class": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "identity_texts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 1
    },
    "scroll_notches": {
      "type": "integer",
      "minimum": -5,
      "maximum": -1
    },
    "scroll_at": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "kind": {
            "enum": [
              "list",
              "detail",
              "article",
              "search",
              "menu"
            ]
          },
          "region": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 4,
            "maxItems": 4
          },
          "required_patterns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "minItems": 1
          },
          "reject_patterns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "minItems": 0
          },
          "item_start": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "min_items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "id_field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "pattern": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "required": [
                "name",
                "pattern"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "allow_scroll": {
            "type": "boolean"
          },
          "id_min_confidence": {
            "type": "number",
            "minimum": 0.7,
            "maximum": 1
          },
          "routes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "selector": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "region": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "target_page": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "relation": {
                  "enum": [
                    "child",
                    "expand"
                  ]
                },
                "mode": {
                  "enum": [
                    "once",
                    "each"
                  ]
                },
                "purpose": {
                  "const": "read_only"
                },
                "review_evidence": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "min_confidence": {
                  "type": "number",
                  "minimum": 0.7,
                  "maximum": 1
                },
                "target_key_pattern": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "verify_pattern": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "return_control": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "text"
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        }
                      },
                      "required": [
                        "type",
                        "text"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "calibrated_point"
                        },
                        "at": {
                          "type": "array",
                          "items": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "minItems": 2,
                          "maxItems": 2
                        },
                        "evidence": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        }
                      },
                      "required": [
                        "type",
                        "at",
                        "evidence"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "target_key_region": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "minItems": 4,
                  "maxItems": 4
                }
              },
              "required": [
                "id",
                "selector",
                "region",
                "target_page",
                "relation",
                "mode",
                "purpose",
                "review_evidence"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "relation": {
                        "const": "child"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "return_control"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "relation": {
                        "const": "expand"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "verify_pattern"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "mode": {
                        "const": "each"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "target_key_pattern",
                      "target_key_region"
                    ]
                  }
                }
              ]
            },
            "maxItems": 20
          },
          "capture": {
            "type": "boolean"
          },
          "identity_texts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "kind",
          "region",
          "required_patterns",
          "reject_patterns",
          "fields",
          "allow_scroll"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "list"
                }
              }
            },
            "then": {
              "required": [
                "item_start",
                "min_items"
              ]
            }
          }
        ]
      },
      "minItems": 1
    },
    "navigation": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "max_actions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "max_scrolls_per_page": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        }
      },
      "required": [
        "enabled",
        "max_depth",
        "max_actions",
        "max_scrolls_per_page"
      ],
      "additionalProperties": false
    },
    "overlays": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "patterns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "minItems": 2,
            "maxItems": 10
          },
          "region": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 4,
            "maxItems": 4
          },
          "close_region": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 4,
            "maxItems": 4
          },
          "identity_region": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 4,
            "maxItems": 4
          },
          "identity_pattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "review_evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "purpose": {
            "const": "dismiss_only"
          },
          "close_template_png": {
            "type": "string",
            "minLength": 10,
            "maxLength": 50000
          }
        },
        "required": [
          "id",
          "patterns",
          "region",
          "close_region",
          "identity_region",
          "identity_pattern",
          "review_evidence",
          "purpose",
          "close_template_png"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "profile_id",
    "window_title",
    "window_class",
    "identity_texts",
    "scroll_notches",
    "scroll_at",
    "pages"
  ],
  "additionalProperties": false
}